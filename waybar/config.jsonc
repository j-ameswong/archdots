{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,

  // Load Modules
  "modules-left": ["hyprland/workspaces", "sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    // "disk",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "network",
    "battery",
  ],

  // --- Module Configuration --- //

  // Workspaces (Hyprland)
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
  },
  // Workspaces (Sway - fallback)
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
  },

  "clock": {
    "format": "{:%H:%M | %a %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "disk": {
    "interval": 30,
    // formatted as: Icon | Percentage Used | Total Amount Free
    "format": "  {percentage_used}%",
    "path": "/",
    "on-click": "kitty --class=kitty-special --override initial_window_width=100c --override initial_window_height=30c -e dysk",
    "tooltip": true,
    "tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)",
    "states": {
      "warning": 80,
      "critical": 90,
    },
  },
  "bluetooth": {
    // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
    "format": " On",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {device_alias}",
    "max-length": 10,
    "ellipsize": true,
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty --class=kitty-special --override initial_window_width=100c --override initial_window_height=30c -e bluetui",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "kitty --class=kitty-special --override initial_window_width=100c --override initial_window_height=30c -e wiremix",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", ""],
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": " Cable",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "kitty --class=kitty-special --override initial_window_width=100c --override initial_window_height=30c -e nmtui",
    "max-length": 10,
    "ellipsize": true,
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10,
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "on-click": "kitty --class=kitty-special --override initial_window_width=100c --override initial_window_height=30c -e sudo tlp-stat",
  },
}
