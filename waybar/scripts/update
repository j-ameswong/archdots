#!/usr/bin/env bash
#
# Update Arch Linux packages, then the toolchains and plugins pacman doesn't
# manage (see post_upgrade)
#
# Dependencies:
#   - pacman-contrib (checkupdates)
#   - libnotify (notify-send)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 16, 2025
# License: MIT

AUR_HELPER=

MD_RESET=$'\e[0m'
FG_RED=$'\e[31m'
FG_GREEN=$'\e[32m'
FG_BLUE=$'\e[34m'

# Names of post-upgrade steps that exited non-zero
FAILED_STEPS=()

print_help() {
	local script=${0##*/}

	cat <<-EOF
		$script: $script [option]
		    Update Arch Linux packages

		    Options:
		      data      Print data in JSON format
	EOF
}

detect_helper() {
	if [[ -z $AUR_HELPER ]]; then
		local helper
		for helper in aura pakku paru pikaur trizen yay; do
			if command -v "$helper" >/dev/null; then
				AUR_HELPER=$helper
				return 0
			fi
		done
	fi
}

detect_updates() {
	local repo_updates repo_status
	repo_updates=$(checkupdates)
	repo_status=$?

	if ((repo_status != 0 && repo_status != 2)); then
		return 1
	fi

	repo_updates=$(grep -c . <<<"$repo_updates")

	if [[ -n $AUR_HELPER ]]; then
		local aur_updates aur_status
		aur_updates=$(command "$AUR_HELPER" -Qua)
		aur_status=$?

		if ((aur_status != 0 && ${#aur_updates} > 0)); then
			return 1
		fi

		aur_updates=$(awk '$NF != "[ignored]" {print $1}' <<<"$aur_updates" |
			grep -c .)
	fi

	printf "%d %d" "${repo_updates:-0}" "${aur_updates:-0}"
}

# Run a post-upgrade step if the command it needs is installed. Failures are
# recorded rather than fatal so one broken tool doesn't block the rest.
run_step() {
	local name=$1 requires=$2
	shift 2

	command -v "$requires" >/dev/null || return 0

	printf "\n%b==> %s%b\n" "$FG_BLUE" "$name" "$MD_RESET"
	"$@" || FAILED_STEPS+=("$name")
}

update_zinit() {
	zsh -c '
		source "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git/zinit.zsh" &&
			zinit self-update &&
			zinit update --all --quiet
	'
}

# lazy.nvim plugins, treesitter parsers, and Mason packages. :MasonUpdate only
# refreshes the registry, so outdated packages are reinstalled explicitly.
update_neovim() {
	local script status
	script=$(mktemp --suffix=.lua)

	cat >"$script" <<-'EOF'
		require("nvim-treesitter").update():wait(300000)

		local registry = require("mason-registry")
		registry.refresh()

		local pending, failed = 0, {}
		for _, pkg in ipairs(registry.get_installed_packages()) do
			if pkg:get_installed_version() ~= pkg:get_latest_version() then
				pending = pending + 1
				io.write("mason: updating " .. pkg.name .. "\n")
				pkg:install({}, function(success)
					if not success then
						table.insert(failed, pkg.name)
					end
					pending = pending - 1
				end)
			end
		end
		vim.wait(600000, function() return pending == 0 end, 200)

		if #failed > 0 then
			io.write("mason: failed to update " .. table.concat(failed, ", ") .. "\n")
			vim.cmd.cquit(1)
		end
	EOF

	nvim --headless "+Lazy! sync" "+luafile $script" +qa
	status=$?
	rm -f "$script"
	return $status
}

post_upgrade() {
	run_step "rustup toolchains" rustup rustup update
	run_step "flatpak" flatpak \
		sh -c 'flatpak update -y --noninteractive && flatpak uninstall --unused -y --noninteractive'
	run_step "uv pythons" uv uv python upgrade
	run_step "uv tools" uv uv tool upgrade --all
	run_step "neovim" nvim update_neovim
	run_step "zinit" zsh update_zinit
	run_step "yazi packages" ya ya pkg upgrade
	run_step "playwright browsers" playwright playwright install
	run_step "mise" mise sh -c 'mise self-update -y && mise upgrade'
	run_step "ghcup" ghcup ghcup upgrade
	run_step "cursor-agent" cursor-agent cursor-agent update
	run_step "opencode" opencode opencode upgrade
}

print_data() {
	local updates icon tooltip

	if ! updates=$(detect_updates); then
		icon="󰒑"
		tooltip="<b>Failed to detect updates</b>"
		tooltip+="\nRight-click to retry"
	else
		local repo_updates aur_updates
		read -r repo_updates aur_updates <<<"$updates"

		if ((repo_updates + aur_updates > 0)); then
			icon="󰄠"
			tooltip="<b>Repo</b>: $repo_updates"

			if [[ -n $AUR_HELPER ]]; then
				tooltip+="\n<b>AUR</b>:  $aur_updates"
			fi
		else
			icon="󰸟"
			tooltip="No updates available"
		fi
	fi

	cat <<-EOF
		{ "text": "$icon", "tooltip": "$tooltip" }
	EOF
}

main() {
	local option=$1

	case $option in
		'')
			trap "pkill -RTMIN+1 waybar" EXIT

			detect_helper

			printf "%bUpdating packages...%b\n" "$FG_BLUE" "$MD_RESET"

			local status
			if [[ -n $AUR_HELPER ]]; then
				command "$AUR_HELPER" -Syu
			else
				sudo pacman -Syu
			fi
			status=$?

			if ((status != 0)); then
				notify-send "Update Failed" --icon "dialog-error"
				printf "\n%bSystem upgrade failed, skipping post-upgrade steps.%b\n" \
					"$FG_RED" "$MD_RESET"
			elif post_upgrade; ((${#FAILED_STEPS[@]} > 0)); then
				notify-send "Update Complete" "Failed: ${FAILED_STEPS[*]}" --icon "dialog-warning"
				printf "\n%bUpdate complete, but these steps failed:%b %s\n" \
					"$FG_RED" "$MD_RESET" "${FAILED_STEPS[*]}"
			else
				notify-send "Update Complete" --icon "package-install"
				printf "\n%bUpdate complete!%b\n" "$FG_GREEN" "$MD_RESET"
			fi

			read -rn 1 -p "Press any key to exit..."
			;;
		data)
			detect_helper
			print_data
			;;
		*)
			print_help >&2
			return 1
			;;
	esac
}

main "$@"
